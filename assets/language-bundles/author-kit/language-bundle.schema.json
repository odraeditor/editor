{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://odraeditor.org/schemas/language-bundle-v1.json",
  "title": "Odra language bundle manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "format-version",
    "id",
    "display-name",
    "version",
    "api-range",
    "description",
    "publisher",
    "source",
    "provenance",
    "targets",
    "dependencies",
    "authorities",
    "contributions",
    "artifacts",
    "entrypoint"
  ],
  "properties": {
    "schema": { "const": 1 },
    "format-version": { "const": 1 },
    "id": { "$ref": "#/$defs/identity" },
    "display-name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "version": { "$ref": "#/$defs/version" },
    "api-range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "$ref": "#/$defs/version" },
        "maximum": { "$ref": "#/$defs/version" }
      }
    },
    "description": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "publisher": { "$ref": "#/$defs/identity" },
    "source": { "$ref": "#/$defs/identity" },
    "provenance": { "type": "string", "minLength": 1, "maxLength": 256 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/target" }
    },
    "dependencies": {
      "type": "array",
      "maxItems": 256,
      "items": { "$ref": "#/$defs/dependency" }
    },
    "authorities": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "external-process",
          "native-grammar",
          "network-acquisition",
          "project-read",
          "project-write",
          "racket-extension"
        ]
      }
    },
    "contributions": {
      "type": "array",
      "maxItems": 640,
      "items": { "$ref": "#/$defs/contribution" }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 1024,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "entrypoint": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/relative-path" }
      ]
    }
  },
  "$defs": {
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "relative-path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))[^\\u0000]+$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "minor", "patch", "pre-release"],
      "properties": {
        "major": { "type": "integer", "minimum": 0 },
        "minor": { "type": "integer", "minimum": 0 },
        "patch": { "type": "integer", "minimum": 0 },
        "pre-release": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "minLength": 1, "maxLength": 96 }
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "architecture"],
      "properties": {
        "platform": { "enum": ["darwin", "linux", "windows"] },
        "architecture": { "enum": ["aarch64", "x86-64"] }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "minimum", "maximum", "optional", "facets", "targets"],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "minimum": { "$ref": "#/$defs/version" },
        "maximum": { "$ref": "#/$defs/version" },
        "optional": { "type": "boolean" },
        "facets": { "type": "array", "maxItems": 6, "items": { "$ref": "#/$defs/identity" } },
        "targets": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/target" } }
      }
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "languages", "artifacts", "dependencies", "authorities"],
      "properties": {
        "kind": { "enum": ["language", "syntax-provider", "service", "formatter", "command", "keymap"] },
        "id": { "$ref": "#/$defs/identity" },
        "languages": { "type": "array", "items": { "$ref": "#/$defs/identity" } },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/identity" } },
        "dependencies": { "type": "array", "items": { "$ref": "#/$defs/identity" } },
        "authorities": { "type": "array", "items": { "$ref": "#/$defs/identity" } }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "digest", "size", "targets", "authority"],
      "properties": {
        "id": { "$ref": "#/$defs/identity" },
        "kind": { "enum": ["data", "documentation", "executable", "license", "manifest", "query", "racket-module", "tree-sitter-grammar"] },
        "path": { "$ref": "#/$defs/relative-path" },
        "digest": { "$ref": "#/$defs/digest" },
        "size": { "type": "integer", "minimum": 0, "maximum": 1099511627776 },
        "targets": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/target" } },
        "authority": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/identity" }
          ]
        }
      }
    }
  }
}
