/* NATIVE_CONTRACT_SCHEMA_BYTES is the exact fixed startup manifest width. */
NATIVE_CONTRACT_SCHEMA_BYTES :: NATIVE_CONTRACT_SCHEMA_HEADER_BYTES +
	len(NATIVE_CONTRACT_SCHEMA_ENTRIES) * NATIVE_CONTRACT_SCHEMA_ENTRY_BYTES

/* native_contract_schema_bytes returns the exact bounded manifest width. */
native_contract_schema_bytes :: proc() -> u64 {
	return NATIVE_CONTRACT_SCHEMA_BYTES
}

/* native_contract_schema_encode copies the complete little-endian startup manifest. */
native_contract_schema_encode :: proc(destination: []u8) -> bool {
	required := native_contract_schema_bytes()
	if required > u64(max(int)) || len(destination) != int(required) {
		return false
	}
	put_schema_u64(destination, 0, NATIVE_CONTRACT_SCHEMA_MAGIC)
	put_schema_u64(destination, 8, NATIVE_CONTRACT_SCHEMA_VERSION)
	put_schema_u64(destination, 16, NATIVE_CONTRACT_SCHEMA_HEADER_BYTES)
	put_schema_u64(destination, 24, u64(len(NATIVE_CONTRACT_SCHEMA_ENTRIES)))
	for entry, index in NATIVE_CONTRACT_SCHEMA_ENTRIES {
		base := NATIVE_CONTRACT_SCHEMA_HEADER_BYTES +
		        u64(index) * NATIVE_CONTRACT_SCHEMA_ENTRY_BYTES
		put_schema_u64(destination, base, u64(entry.concern))
		put_schema_u64(destination, base + 8, entry.item)
		put_schema_u64(destination, base + 16, entry.value)
	}
	return true
}

@(private)
put_schema_u64 :: proc(destination: []u8, offset, value: u64) {
	written := endian.put_u64(destination[int(offset):], .Little, value)
	assert(written)
}
