package bridge

import "../transaction"
import "../theme"
import "../ui"
import "../language_service"
import "../result_set"
import "../status_bar"
import endian "core:encoding/endian"

/* NATIVE_CONTRACT_SCHEMA_MAGIC identifies the copied startup manifest. */
NATIVE_CONTRACT_SCHEMA_MAGIC :: u64(0x4f445241434f4e54)
/* NATIVE_CONTRACT_SCHEMA_VERSION changes whenever a published contract changes. */
NATIVE_CONTRACT_SCHEMA_VERSION :: u64(29)
/* NATIVE_CONTRACT_SCHEMA_HEADER_BYTES is the fixed manifest header width. */
NATIVE_CONTRACT_SCHEMA_HEADER_BYTES :: u64(32)
/* NATIVE_CONTRACT_SCHEMA_ENTRY_BYTES is one concern, item, and value tuple. */
NATIVE_CONTRACT_SCHEMA_ENTRY_BYTES :: u64(24)

/* Transaction_Operation identifies one admitted transaction callback request. */
Transaction_Operation :: enum i32 {
	Inspect = 1,
	Batch = 2,
	Splice = 3,
	Nested_Begin = 4,
	Nested_Succeed = 5,
	Nested_Fail = 6,
	Abort = 7,
	Jan_Analyze = 8,
}

/* TRANSACTION_EDIT_RECORD_BYTES is one copied base-relative edit width. */
TRANSACTION_EDIT_RECORD_BYTES :: u64(size_of(Transaction_Edit_Record))
/* MAX_TRANSACTION_INSPECTION_BYTES bounds one copied inspection response. */
MAX_TRANSACTION_INSPECTION_BYTES :: u64(64 * 1024 * 1024)
/* MAX_TRANSACTION_BATCH_SPLICES mirrors the native splice ceiling. */
MAX_TRANSACTION_BATCH_SPLICES :: u64(transaction.MAX_SPLICES)
/* MAX_TRANSACTION_TEXT_BYTES mirrors the native retained-text ceiling. */
MAX_TRANSACTION_TEXT_BYTES :: u64(transaction.MAX_TEXT_BYTES)
/* MAX_TRANSACTION_NESTED_DEPTH mirrors the native composition ceiling. */
MAX_TRANSACTION_NESTED_DEPTH :: u64(transaction.MAX_NESTED_COMMAND_DEPTH)
/* MAX_TRANSACTION_DESCRIPTOR_BYTES mirrors the native command-name ceiling. */
MAX_TRANSACTION_DESCRIPTOR_BYTES :: u64(transaction.MAX_COMMAND_BYTES)

/* Native_Contract_Concern identifies one independently owned record family. */
Native_Contract_Concern :: enum u64 {
	Transaction = 1,
	Transfer = 2,
	Search = 3,
	Buffer_Session = 4,
	Keymap_Profile = 5,
	Command_Catalog = 6,
	Layout = 7,
	UI_Role = 8,
	Theme = 9,
	Structural = 10,
	Language_Service = 11,
	Result = 12,
	Status_Bar = 13,
	Terminal = 14,
	Jan_Language = 16,
	Jan_Planning = 17,
	Jan_Computation = 18,
	Jan_Output = 19,
}

/* Native_Contract_Schema_Entry publishes one authoritative scalar contract. */
Native_Contract_Schema_Entry :: struct {
	concern: Native_Contract_Concern,
	item:    u64,
	value:   u64,
}

/* NATIVE_CONTRACT_SCHEMA_ENTRIES is the complete ordered native authority table. */
NATIVE_CONTRACT_SCHEMA_ENTRIES :: [?]Native_Contract_Schema_Entry {
	// Transaction records, limits, and callback operations.
	{.Transaction, 1, TRANSACTION_EDIT_RECORD_BYTES},
