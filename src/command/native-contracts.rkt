(define expected-by-name
  (for/hash ([entry (in-list expected-entries)])
    (values (cons (vector-ref entry 2) (vector-ref entry 3))
            (vector-ref entry 4))))

(define expected-by-code
  (for/hash ([entry (in-list expected-entries)])
    (values (cons (vector-ref entry 0) (vector-ref entry 1)) entry)))

;; native-contract-value returns one centrally declared facade constant.
(define (native-contract-value concern item)
  (hash-ref expected-by-name (cons concern item)
            (lambda ()
              (raise-arguments-error 'native-contract-value
                                     "unknown native contract"
                                     "concern" concern
                                     "item" item))))

;; validate-native-contract-schema! rejects drift before any capability procedure loads.
(define (validate-native-contract-schema! schema)
  (unless (>= (bytes-length schema) schema-header-bytes)
    (error 'native-contract-schema "truncated header"))
  (define magic (read-u64 schema 0))
  (define version (read-u64 schema 8))
  (define header-bytes (read-u64 schema 16))
  (define entry-count (read-u64 schema 24))
  (unless (= magic schema-magic)
    (error 'native-contract-schema "invalid magic"))
  (unless (= version schema-version)
    (error 'native-contract-schema
           "version mismatch: expected ~a, received ~a" schema-version version))
  (unless (= header-bytes schema-header-bytes)
    (error 'native-contract-schema
           "header width mismatch: expected ~a, received ~a"
           schema-header-bytes header-bytes))
  (unless (<= entry-count maximum-schema-entries)
    (error 'native-contract-schema "entry count exceeds ~a" maximum-schema-entries))
  (define expected-length (+ header-bytes (* entry-count schema-entry-bytes)))
  (unless (= (bytes-length schema) expected-length)
    (error 'native-contract-schema
           "size mismatch: expected ~a, received ~a"
           expected-length (bytes-length schema)))
  (define seen (make-hash))
  (for ([index (in-range entry-count)])
    (define base (+ header-bytes (* index schema-entry-bytes)))
    (define key (cons (read-u64 schema base) (read-u64 schema (+ base 8))))
    (define entry (hash-ref expected-by-code key #f))
    (unless entry
      (error 'native-contract-schema "unknown contract ~a/~a" (car key) (cdr key)))
    (when (hash-has-key? seen key)
      (error 'native-contract-schema "duplicate contract ~a/~a" (car key) (cdr key)))
    (hash-set! seen key #t)
    (define expected (vector-ref entry 4))
    (define actual (read-u64 schema (+ base 16)))
    (unless (= actual expected)
      (error 'native-contract-schema
             "mismatch at ~a/~a: expected ~a, received ~a"
             (vector-ref entry 2) (vector-ref entry 3) expected actual)))
  (unless (= (hash-count seen) (length expected-entries))
    (error 'native-contract-schema
           "missing contracts: expected ~a, received ~a"
           (length expected-entries) (hash-count seen)))
  (void))

(define (read-u64 bytes offset)
  (integer-bytes->integer bytes #f #f offset (+ offset 8)))

(module+ test
  (require rackunit)

  (define (write-u64! bytes offset value)
    (integer->integer-bytes value 8 #f #f bytes offset)
    (void))

  (define (expected-schema)
    (define schema
      (make-bytes (+ schema-header-bytes
                     (* (length expected-entries) schema-entry-bytes))))
    (for ([value (in-list
                  (list schema-magic schema-version schema-header-bytes
                        (length expected-entries)))]
          [offset (in-range 0 schema-header-bytes 8)])
      (write-u64! schema offset value))
    (for ([entry (in-list expected-entries)] [index (in-naturals)])
      (define base (+ schema-header-bytes (* index schema-entry-bytes)))
      (write-u64! schema base (vector-ref entry 0))
      (write-u64! schema (+ base 8) (vector-ref entry 1))
      (write-u64! schema (+ base 16) (vector-ref entry 4)))
    schema)

  (define (entry-offset concern item)
    (for/first ([entry (in-list expected-entries)] [index (in-naturals)]
                #:when (and (eq? concern (vector-ref entry 2))
                            (eq? item (vector-ref entry 3))))
      (+ schema-header-bytes (* index schema-entry-bytes) 16)))

  (check-true (void? (validate-native-contract-schema! (expected-schema))))
  (check-exn #rx"truncated header"
             (lambda () (validate-native-contract-schema! #"short")))
  (for ([target (in-list
                 '((transaction edit-record-bytes)
                   (transfer operation-ring)
                   (search maximum-pattern-bytes)
                   (layout operation-set-dedication)
                   (ui-role operation-replace)
                   (ui-role renderer-full-redraw)
                   (theme operation-replace)
                   (theme failure-stale-selection)
                   (theme role-syntax-function)
                   (theme attribute-reverse)
                   (structural operation-indent)
                   (structural maximum-inspection-bytes)
                   (status-bar operation-register)
                   (status-bar maximum-proposal-bytes)
                   (terminal operation-send-key)
                   (jan-language operation-language-status)))])
    (define schema (expected-schema))
    (define offset (entry-offset (car target) (cadr target)))
    (write-u64! schema offset (add1 (read-u64 schema offset)))
    (check-exn #rx"mismatch at"
               (lambda () (validate-native-contract-schema! schema))))
  (define wrong-version (expected-schema))
  (write-u64! wrong-version 8 (add1 schema-version))
  (check-exn #rx"version mismatch"
             (lambda () (validate-native-contract-schema! wrong-version))))
