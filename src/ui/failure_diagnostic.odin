package ui

/* failure_code_diagnostic returns one stable human-readable logical UI rejection. */
failure_code_diagnostic :: proc(code: Failure_Code) -> string {
	switch code {
	case .None: return ""
	case .Invalid_Registry: return "invalid UI registry"
	case .Invalid_Proposal: return "invalid UI proposal"
	case .Closed_Registry: return "closed UI registry"
	case .Wrong_Registry: return "wrong UI registry"
	case .Invalid_Owner: return "invalid semantic owner"
	case .Wrong_Owner: return "wrong semantic owner"
	case .Invalid_Root: return "invalid UI root"
	case .Stale_Root: return "stale UI root generation"
	case .Invalid_Surface: return "invalid UI surface"
	case .Stale_Surface: return "stale UI surface generation"
	case .Invalid_View: return "invalid visual view"
	case .Stale_View: return "stale visual view generation"
	case .Invalid_Text_View: return "invalid text view projection"
	case .Stale_Text_View: return "stale text view generation"
	case .Incompatible_Text_View: return "incompatible text view generation"
	case .Invalid_Terminal_View: return "invalid terminal view projection"
	case .Malformed_Terminal_Cell: return "malformed terminal cell text"
	case .Invalid_List_View: return "invalid list view projection"
	case .Stale_List_View: return "stale list view generation"
	case .Invalid_List_Item: return "invalid list item"
	case .Duplicate_List_Item: return "duplicate list item identity"
	case .Invalid_List_Action: return "invalid list action"
	case .Invalid_List_Mark: return "invalid list mark"
	case .Malformed_List_Text: return "malformed list text"
	case .Invalid_Tree_View: return "invalid tree view projection"
	case .Invalid_Tree_Node: return "invalid tree node"
	case .Duplicate_Tree_Node: return "duplicate tree node identity"
	case .Malformed_Tree_Text: return "malformed tree text"
	case .Invalid_Layout: return "invalid UI layout"
	case .Stale_Layout: return "stale layout generation"
	case .Incompatible_Layout: return "incompatible layout generation"
	case .Invalid_Projection: return "invalid model projection"
	case .Stale_Projection: return "stale model projection generation"
	case .Invalid_Composition: return "invalid UI composition"
	case .Invalid_Status_Region: return "invalid status region"
	case .Invalid_Hit: return "invalid UI hit request"
	case .Invalid_Popup: return "invalid popup"
	case .Stale_Popup: return "stale popup generation"
	case .Invalid_Popup_Anchor: return "invalid popup anchor"
	case .Invalid_Popup_Content: return "invalid popup content"
	case .Invalid_Style: return "invalid semantic style"
	case .Invalid_Decoration: return "invalid semantic decoration"
	case .Invalid_Focus: return "invalid focus target"
	case .Focus_Captured: return "focus is already captured"
	case .Invalid_Transient_Input: return "transient input is unavailable"
	case .Transient_Input_Captured: return "transient input is already captured"
	case .No_Focus_Fallback: return "no safe focus fallback"
	case .Surface_Limit: return "UI surface limit exceeded"
	case .View_Limit: return "visual view limit exceeded"
	case .Composition_Limit: return "composition node limit exceeded"
	case .Split_Depth_Limit: return "split depth limit exceeded"
	case .Status_Region_Limit: return "status region limit exceeded"
	case .Popup_Limit: return "popup limit exceeded"
	case .Popup_Content_Limit: return "popup content byte limit exceeded"
	case .Popup_Action_Limit: return "popup action limit exceeded"
	case .List_Item_Limit: return "list item limit exceeded"
	case .Tree_Node_Limit: return "tree node limit exceeded"
	case .Input_Limit: return "input byte limit exceeded"
	case .Fixed_Choice_Limit: return "fixed choice limit exceeded"
	case .Projection_Limit: return "projection byte limit exceeded"
	case .Style_Limit: return "semantic style limit exceeded"
	case .Decoration_Limit: return "semantic decoration limit exceeded"
	case .Compact_Region_Limit: return "compact region byte limit exceeded"
	case .Event_Subscription_Limit: return "event subscription limit exceeded"
	case .Queue_Limit: return "UI event queue limit exceeded"
	case .Callback_Depth_Limit: return "callback depth limit exceeded"
	case .Deferred_Work_Limit: return "deferred work limit exceeded"
	case .Snapshot_Limit: return "UI snapshot byte limit exceeded"
	case .Temporary_Memory_Limit: return "temporary UI memory limit exceeded"
	case .Diagnostic_Limit: return "diagnostic byte limit exceeded"
	case .Geometry_Work_Limit: return "geometry work limit exceeded"
	case .Renderer_Incompatible: return "renderer capabilities are incompatible"
	case .Generation_Limit: return "UI generation limit exhausted"
	case .Checked_Integer_Overflow: return "checked UI size arithmetic overflow"
	case .Allocation: return "UI allocation failed"
	case .Busy: return "UI registry has an active proposal"
	}
	return "unknown UI failure"
}

/* role_failure_code_diagnostic returns one stable human-readable provider rejection. */
role_failure_code_diagnostic :: proc(code: Role_Failure_Code) -> string {
	switch code {
	case .None: return ""
	case .Invalid_Registry: return "invalid UI role registry"
	case .Closed_Registry: return "closed UI role registry"
	case .Invalid_Session: return "invalid UI role session"
	case .Invalid_Role: return "invalid UI role"
	case .Invalid_Provider: return "invalid UI role provider"
	case .Stale_Provider: return "stale UI role provider generation"
	case .Provider_Limit: return "UI role provider limit exceeded"
	case .Provider_Name_Limit: return "provider name limit exceeded"
	case .Package_Name_Limit: return "package name limit exceeded"
	case .Duplicate_Provider: return "duplicate UI role provider"
	case .Stale_Scope: return "stale UI role scope"
	case .Provider_Not_Package: return "provider is not package-owned"
	case .Provider_Not_Registered: return "package provider is not registered"
	case .Provider_Not_Confirmed: return "package provider is not confirmed"
	case .Provider_Not_Active: return "package provider is not active"
	case .Renderer_Incompatible: return "provider renderer requirements are incompatible"
	case .Stale_Root: return "provider root generation is stale"
	case .Proposal_Limit: return "provider proposal byte limit exceeded"
	case .Callback_Budget: return "provider callback budget exhausted"
	case .Focus_Effect: return "provider proposal cannot change focus"
	case .Layout_Effect: return "provider proposal cannot change layout"
	case .Command_Name_Limit: return "provider command name limit exceeded"
	case .Command_Not_Admitted: return "provider command is not admitted"
	case .Generation_Limit: return "provider generation limit exhausted"
	case .Allocation: return "UI role provider allocation failed"
	}
	return "unknown UI role failure"
}
