#hasheq((project . site)
        (entries . (#hasheq((path . "assets/site.css") (output . 207)
                             (kind . static-copy) (reuse? . #f))
                    #hasheq((path . "docs/a.org") (output . 203)
                             (kind . generated) (reuse? . #t))
                    #hasheq((path . "docs/z.org") (output . 201)
                             (kind . generated) (reuse? . #f))
                    #hasheq((path . "sitemap.xml") (output . 401)
                             (kind . sitemap) (reuse? . #f))
                    #hasheq((path . "index.html") (output . 403)
                             (kind . index) (reuse? . #f))))
        (stale . (#hasheq((resource . 301) (action . delete))
                   #hasheq((resource . 303) (action . preserve))))
        (local-state . candidate)
        (remote-state . not-started)
        (complete? . #t))
