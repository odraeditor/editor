#hasheq((title . "Native Backends")
        (language . "en")
        (blocks . (#hasheq((kind . heading) (level . 1)
                            (fragments . (#hasheq((kind . text) (text . "Overview & status")))))
                   #hasheq((kind . paragraph)
                            (fragments . (#hasheq((kind . text) (text . "Read "))
                                          #hasheq((kind . strong) (text . "carefully"))
                                          #hasheq((kind . text) (text . " and visit "))
                                          #hasheq((kind . link) (text . "Odra")
                                                   (target . "https://example.test/?a=1&b=2"))
                                          #hasheq((kind . text) (text . ".")))))
                   #hasheq((kind . source) (language . "racket")
                            (fragments . (#hasheq((kind . text) (text . "(+ 1 2)")))))
                   #hasheq((kind . paragraph)
                            (fragments . (#hasheq((kind . image) (text . "Diagram")
                                                   (target . "media/diagram.png"))))))))
