(require rackunit
         racket/file
         racket/path
         racket/port
         racket/string
         racket/system
         "../support/terminal-readiness.rkt")

(define script-path (find-executable-path "script"))
(check-not-false script-path "util-linux script is required for Ksawery sequence workflow acceptance")
(define git-path (find-executable-path "git"))
(check-not-false git-path "git is required for Ksawery sequence workflow acceptance")
(define odra-path (getenv "ODRA_PTY_EXECUTABLE"))
(check-not-false odra-path "ODRA_PTY_EXECUTABLE must identify the built executable")

(define meta-x #"\33x")
(define enter (bytes 13))
(define control-enter #"\33[13;5u")
(define down #"\33[B")
(define restoration #"\33[?25h\33[0m")

(define (contains? output value)
  (regexp-match? (byte-regexp (regexp-quote value)) output))

(define (transcript-tail output [limit 10000])
  (define length (bytes-length output))
  (subbytes output (max 0 (- length limit))))

(define (report-transcript-tail output)
  (displayln (bytes->string/utf-8 (transcript-tail output) #\?)
             (current-error-port)))

(define (shell-quote value)
  (string-append "'" (regexp-replace* #rx"'" value "'\"'\"'") "'"))

(define root (make-temporary-file "odra-ksawery-sequence-workflow-~a" 'directory))

(dynamic-wind
 void
 (lambda ()
   (define home (build-path root "home"))
   (define remote (build-path root "origin.git"))
   (define seed (build-path root "seed"))
   (define repository (build-path home "repository"))
   (define start-path (build-path repository "start.odin"))
   (define flow-path (build-path repository "flow.txt"))
   (define seed-flow-path (build-path seed "flow.txt"))
   (define pick-path (build-path repository "pick.txt"))
   (define start-content
     "package ksawery_sequence_acceptance\n\nphase := \"baseline\"\n")
   (define (write-file! path content)
     (call-with-output-file path
       #:exists 'truncate
       (lambda (output) (display content output))))
   (define (git-at! directory . arguments)
     (parameterize ([current-directory directory])
       (apply system* git-path arguments)))
   (define (git-text directory . arguments)
     (parameterize ([current-directory directory])
       (define-values (child output input error-output)
         (apply subprocess #f #f #f git-path arguments))
       (close-output-port input)
       (define result (port->string output))
       (define diagnostic (port->string error-output))
       (subprocess-wait child)
       (close-input-port output)
       (close-input-port error-output)
       (check-equal? (subprocess-status child) 0 diagnostic)
       (string-trim result)))
   (define (git-path-exists? name)
     (file-exists? (build-path repository ".git" name)))

   (make-directory* (build-path home ".config" "odra"))
   (make-directory seed)
   (check-true (git-at! root "init" "--bare" "-q" "--initial-branch=main" remote))
   (check-true (git-at! seed "init" "-q" "-b" "main"))
   (check-true (git-at! seed "config" "user.name" "Odra Test"))
   (check-true (git-at! seed "config" "user.email" "odra@example.invalid"))
   (check-true (git-at! seed "config" "commit.gpgSign" "false"))
   (write-file! (build-path seed "start.odin") start-content)
   (write-file! seed-flow-path "baseline\n")
   (check-true (git-at! seed "add" "--" "start.odin" "flow.txt"))
   (check-true (git-at! seed "commit" "-qm" "baseline"))
   (check-true (git-at! seed "remote" "add" "origin" remote))
   (check-true (git-at! seed "push" "-q" "-u" "origin" "main"))

   (make-directory repository)
   (check-true (git-at! repository "init" "-q" "-b" "fixture"))
   (check-true (git-at! repository "config" "user.name" "Odra Test"))
   (check-true (git-at! repository "config" "user.email" "odra@example.invalid"))
   (check-true (git-at! repository "config" "commit.gpgSign" "false"))
   (check-true (git-at! repository "remote" "add" "origin" remote))
   (check-true (git-at! repository "fetch" "-q" "origin"
                        "refs/heads/main:refs/remotes/origin/main"))
   (check-true (git-at! repository "checkout" "-q" "-b" "main" "--track"
                        "refs/remotes/origin/main"))
   (write-file! flow-path "local merge side\n")
   (check-true (git-at! repository "add" "--" "flow.txt"))
   (check-true (git-at! repository "commit" "-qm" "local merge side"))
   (write-file! seed-flow-path "remote merge side\n")
   (check-true (git-at! seed "add" "--" "flow.txt"))
   (check-true (git-at! seed "commit" "-qm" "remote merge side"))
   (check-true (git-at! seed "push" "-q" "origin" "main"))

   (define command
     (string-append
      "stty rows 36 cols 150; XDG_CONFIG_HOME="
      (shell-quote (path->string (build-path home ".config")))
      " HOME="
      (shell-quote (path->string home))
      " exec env -u NO_COLOR TERM=xterm-256color COLORTERM=truecolor "
      (shell-quote odra-path)
      " "
      (shell-quote (path->string start-path))))
   (define-values (process output input error-output)
     (subprocess #f #f #f script-path "-qfec" command "/dev/null"))
   (define transcript (open-output-bytes))
   (define error-result (make-channel))
   (wait-for-terminal-readiness!
    'ksawery-sequence-workflow process output input error-output transcript
    #:content-marker #"ksawery_sequence_acceptance")
   (define output-reader (thread (lambda () (copy-port output transcript))))
   (thread (lambda () (channel-put error-result (port->bytes error-output))))
   (define (send bytes [pause 0.25])
     (with-handlers ([exn:fail?
                      (lambda (failure)
                        (report-transcript-tail (get-output-bytes transcript))
                        (raise failure))])
       (write-bytes bytes input)
       (flush-output input))
     (sleep pause))
   (define (await-from value start [seconds 25])
     (define deadline (+ (current-inexact-milliseconds) (* seconds 1000)))
     (let wait ()
       (define current (get-output-bytes transcript))
       (cond
         [(and (<= start (bytes-length current))
               (contains? (subbytes current start) value))
          #t]
         [(>= (current-inexact-milliseconds) deadline)
          (report-transcript-tail current)
          (fail-check (format "timed out waiting for ~s" value))]
         [(sync/timeout 0 process)
          (define process-error (channel-get error-result))
          (report-transcript-tail current)
          (fail-check
           (format "editor exited (~a) while waiting for ~s: ~a"
                   (subprocess-status process)
                   value
                   (bytes->string/utf-8 process-error #\?)))]
         [else
          (sleep 0.05)
          (wait)])))
   (define (move! key count)
     (for ([ignored (in-range count)])
       (send key 0.08)))

   ;; Fetch the remote explicitly, then merge its refreshed tracking ref.
   (define status-start (bytes-length (get-output-bytes transcript)))
   (send (bytes-append meta-x #"ksawery-status" enter))
   (await-from #"Ksawery Status" status-start)
   (await-from #"Working tree clean" status-start)
   (sleep 1.0)
   (define refs-start (bytes-length (get-output-bytes transcript)))
   (send #"b")
   (await-from #"Ksawery Refs" refs-start)
   (await-from #"Remote: origin" refs-start)
   (move! down 2)
   (define fetch-start (bytes-length (get-output-bytes transcript)))
   (send #"M")
   (await-from #"Ksawery Remote" fetch-start)
   (send #"f")
   (await-from #"Fetch result: Completed" fetch-start)
   (sleep 1.0)
   (check-equal? (git-text repository "rev-parse" "refs/remotes/origin/main")
                 (git-text seed "rev-parse" "HEAD"))
   (move! down 2)
   (define merge-start (bytes-length (get-output-bytes transcript)))
   (send #"m")
   (await-from #"Ksawery Merge" merge-start)
   (send #"n")
   (await-from #"Ksawery Merge Confirmation" merge-start)
   (send control-enter)
   (await-from #"Ksawery Sequence" merge-start)
   (await-from #"Conflict: flow.txt" merge-start)
   (send enter)
   (await-from #"Ksawery Conflict" merge-start)
   (await-from #"Current (ours / HEAD)" merge-start)
   (define resolve-start (bytes-length (get-output-bytes transcript)))
   (send #"2")
   (await-from #"Ksawery Conflict Confirmation" resolve-start)
   (send control-enter)
   (await-from #"Ksawery Sequence" resolve-start)
   (check-equal? (git-text repository "diff" "--name-only" "--diff-filter=U") "")
   (define continue-start (bytes-length (get-output-bytes transcript)))
   (send #">")
   (await-from #"Ksawery Merge Confirmation" continue-start)
   (send control-enter)
   (await-from #"Ksawery Status" continue-start)
   (await-from #"Working tree clean" continue-start)
   (sleep 1.0)
   (check-false (git-path-exists? "MERGE_HEAD"))
   (check-true (git-at! repository "merge-base" "--is-ancestor"
                        "refs/remotes/origin/main" "HEAD"))

   (define process-start (bytes-length (get-output-bytes transcript)))
   (send #"$")
   (await-from #"Ksawery Processes" process-start)
   (await-from #"Merge Repository Ref" process-start)
   (await-from #"[Verified_Success]" process-start)
   (send #"q")
   (await-from #"Ksawery Status" process-start)
   (sleep 1.0)

   ;; Create a conflicting replay and abort it through the retained Rebase lineage.
   (define merge-head (git-text repository "rev-parse" "HEAD"))
   (check-true (git-at! repository "checkout" "-q" "-b" "rebase-base-build"))
   (write-file! flow-path "rebase base side\n")
   (check-true (git-at! repository "add" "--" "flow.txt"))
   (check-true (git-at! repository "commit" "-qm" "rebase base"))
   (check-true (git-at! repository "tag" "rebase-base"))
   (check-true (git-at! repository "checkout" "-q" "main"))
   (check-true (git-at! repository "branch" "-D" "rebase-base-build"))
   (write-file! flow-path "rebase replay side\n")
   (check-true (git-at! repository "add" "--" "flow.txt"))
   (check-true (git-at! repository "commit" "-qm" "rebase replay"))
   (define replay-head (git-text repository "rev-parse" "HEAD"))
   (check-not-equal? merge-head replay-head)
   (define rebase-refresh-start (bytes-length (get-output-bytes transcript)))
   (send #"g")
   (await-from #"Working tree clean" rebase-refresh-start)
   (sleep 1.0)
   (send #"b")
   (await-from #"Tag: refs/tags/rebase-base" rebase-refresh-start)
   (move! down 3)
   (define rebase-start (bytes-length (get-output-bytes transcript)))
   (send #"r")
   (await-from #"Ksawery Rebase" rebase-start)
   (send #"r")
   (await-from #"Ksawery Rebase Confirmation" rebase-start)
   (send control-enter)
   (await-from #"Ksawery Sequence" rebase-start)
   (await-from #"Conflict: flow.txt" rebase-start)
   (define rebase-abort-start (bytes-length (get-output-bytes transcript)))
   (send #"Z")
   (await-from #"Ksawery Rebase Confirmation" rebase-abort-start)
   (send control-enter)
   (await-from #"Ksawery Status" rebase-abort-start)
   (await-from #"Working tree clean" rebase-abort-start)
   (sleep 1.0)
   (check-equal? (git-text repository "rev-parse" "HEAD") replay-head)
   (check-false (directory-exists? (build-path repository ".git" "rebase-merge")))
   (check-false (directory-exists? (build-path repository ".git" "rebase-apply")))

   ;; Build an ordered cherry-pick conflict and recover by aborting it.
   (write-file! pick-path "picked value\n")
   (check-true (git-at! repository "add" "--" "pick.txt"))
   (check-true (git-at! repository "commit" "-qm" "pick target"))
   (define pick-target (git-text repository "rev-parse" "HEAD"))
   (check-true (git-at! repository "revert" "--no-edit" pick-target))
   (write-file! pick-path "divergent value\n")
   (check-true (git-at! repository "add" "--" "pick.txt"))
   (check-true (git-at! repository "commit" "-qm" "divergent pick path"))
   (define bad-head (git-text repository "rev-parse" "HEAD"))
   (define pick-refresh-start (bytes-length (get-output-bytes transcript)))
   (send #"g")
   (await-from #"Working tree clean" pick-refresh-start)
   (sleep 1.0)
   (send #"b")
   (await-from #"Ksawery Refs" pick-refresh-start)
   (await-from #"HEAD: refs/heads/main" pick-refresh-start)
   (send #"q")
   (await-from #"Ksawery Status" pick-refresh-start)
   (send #"h")
   (await-from #"Ksawery History" pick-refresh-start)
   (await-from #"divergent pick path" pick-refresh-start)
   (move! down 4)
   (define pick-inspect-start (bytes-length (get-output-bytes transcript)))
   (send #"\t")
   (await-from #"Ksawery Revision Inspection" pick-inspect-start)
   (await-from #"pick target" pick-inspect-start)
   (send #"q")
   (await-from #"Ksawery History" pick-inspect-start)
   (define pick-start (bytes-length (get-output-bytes transcript)))
   (send #"a")
   (await-from #"Ordered set: 1 commit(s)" pick-start)
   (send #"P")
   (await-from #"Ksawery Sequenced Revision Confirmation" pick-start)
   (send control-enter)
   (await-from #"Ksawery Sequence" pick-start)
   (await-from #"Conflict: pick.txt" pick-start)
   (define pick-abort-start (bytes-length (get-output-bytes transcript)))
   (send #"Y")
   (await-from #"Ksawery Sequenced Revision Confirmation" pick-abort-start)
   (send control-enter)
   (await-from #"Ksawery Status" pick-abort-start)
   (await-from #"Working tree clean" pick-abort-start)
   (sleep 1.0)
   (check-equal? (git-text repository "rev-parse" "HEAD") bad-head)
   (check-false (git-path-exists? "CHERRY_PICK_HEAD"))

   ;; Start and reset one manual bisect sequence through explicit confirmations.
   (define bisect-history-start (bytes-length (get-output-bytes transcript)))
   (send #"h")
   (await-from #"Ksawery History" bisect-history-start)
   (define bisect-mark-start (bytes-length (get-output-bytes transcript)))
   (send #"B")
   (await-from #"Marked the exact known-bad bisect boundary" bisect-mark-start)
   (move! down 8)
   (send #"G")
   (await-from #"Known-good bisect boundaries: 1" bisect-mark-start)
   (define bisect-start (bytes-length (get-output-bytes transcript)))
   (send #"?")
   (await-from #"Ksawery Manual Bisect Confirmation" bisect-start)
   (send control-enter)
   (await-from #"Ksawery Sequence" bisect-start)
   (await-from #"Manual progress:" bisect-start)
   (define reset-start (bytes-length (get-output-bytes transcript)))
   (send #"~")
   (await-from #"Ksawery Manual Bisect Confirmation" reset-start)
   (send control-enter)
   (await-from #"Ksawery Status" reset-start)
   (await-from #"Working tree clean" reset-start)
   (sleep 1.0)
   (check-equal? (git-text repository "rev-parse" "HEAD") bad-head)
   (check-false (git-path-exists? "BISECT_START"))

   (define final-process-start (bytes-length (get-output-bytes transcript)))
   (send #"$")
   (await-from #"Ksawery Processes" final-process-start)
   (await-from #"Start Manual Bisect" final-process-start)
   (await-from #"Reset Manual Bisect" final-process-start)
   (send #"q")
   (await-from #"Ksawery Status" final-process-start)

   (define canvas-return-start (bytes-length (get-output-bytes transcript)))
   (send #"q")
   (await-from #"ksawery_sequence_acceptance" canvas-return-start)
   (await-from #"phase := " canvas-return-start)
   (await-from #"\"baseline\"" canvas-return-start)

   (send meta-x 0.2)
   (for ([value (in-bytes #"request-editor-exit")])
     (send (bytes value) 0.03))
   (send enter 0)
   (define completed? (sync/timeout 45 process))
   (unless completed? (subprocess-kill process #t))
   (subprocess-wait process)
   (thread-wait output-reader)
   (define output-bytes (get-output-bytes transcript))
   (define error-bytes (channel-get error-result))
   (close-output-port input)
   (close-input-port output)
   (close-input-port error-output)

   (check-not-false completed? (bytes->string/utf-8 output-bytes #\?))
   (check-equal? (subprocess-status process) 0)
   (check-equal? error-bytes #"")
   (check-true (contains? output-bytes #"Fetch result: Completed"))
   (check-true (contains? output-bytes #"Conflict: flow.txt"))
   (check-true (contains? output-bytes #"Conflict: pick.txt"))
   (check-true (contains? output-bytes #"Manual progress:"))
   (check-true (contains? output-bytes #"Ksawery Processes"))
   (check-true (contains? output-bytes restoration)))
 (lambda ()
   (when (directory-exists? root)
     (delete-directory/files root))))
